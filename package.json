{
  "name": "hommies",
  "version": "0.0.0",
  "private": true,
  "description": "Omarchy bar plugin for coding-agent questions and permissions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "lint": "pnpm -r --filter './packages/*' lint",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "clean": "pnpm -r --filter './packages/*' clean && rm -rf node_modules .pnpm-store"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
