{
  "name": "@thisisayande/hommies",
  "version": "0.1.6",
  "description": "Localhost bridge and agent hooks for Hommies, the Omarchy companion that surfaces pending coding-agent questions and permissions.",
  "license": "MIT",
  "author": "Ayan De",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayandexyz/Hommies.git",
    "directory": "packages/omarchy-bridge"
  },
  "homepage": "https://github.com/ayandexyz/Hommies#readme",
  "bugs": {
    "url": "https://github.com/ayandexyz/Hommies/issues"
  },
  "keywords": [
    "omarchy",
    "claude-code",
    "codex",
    "opencode",
    "hooks",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hommies": "./dist/cli.js",
    "hommies-bridge": "./dist/runtime.js",
    "hommies-claude-hook": "./dist/claude-hook.js",
    "hommies-codex-hook": "./dist/codex-hook.js",
    "hommies-hook": "./dist/agent-hook.js",
    "agent-fold": "./dist/cli.js",
    "agent-fold-bridge": "./dist/runtime.js",
    "agent-fold-claude-hook": "./dist/claude-hook.js",
    "agent-fold-codex-hook": "./dist/codex-hook.js",
    "agent-fold-hook": "./dist/agent-hook.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "sounds",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "lint": "echo 'lint not configured yet' && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "effect": "3.22.2"
  },
  "//": "Provider hook contracts and projection types are declared locally in src/localContracts.ts. Promote them to a published npm package only when another consumer needs them.",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
