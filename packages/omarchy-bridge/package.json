{
  "name": "@thisisayande/hommies",
  "version": "0.1.0",
  "description": "Localhost HTTP bridge that exposes pending coding-agent questions and permissions to the agent-fold Omarchy plugin.",
  "license": "MIT",
  "author": "Ayan De",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayandexyz/agent-fold.git",
    "directory": "packages/omarchy-bridge"
  },
  "homepage": "https://github.com/ayandexyz/agent-fold#readme",
  "bugs": {
    "url": "https://github.com/ayandexyz/agent-fold/issues"
  },
  "keywords": [
    "omarchy",
    "claude-code",
    "codex",
    "opencode",
    "hooks",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hommies": "./dist/cli.js",
    "agent-fold": "./dist/cli.js",
    "agent-fold-bridge": "./dist/runtime.js",
    "agent-fold-claude-hook": "./dist/claude-hook.js",
    "agent-fold-codex-hook": "./dist/codex-hook.js",
    "agent-fold-hook": "./dist/agent-hook.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "sounds",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "lint": "echo 'lint not configured yet' && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
